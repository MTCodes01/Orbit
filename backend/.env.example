# Orbit backend environment — copy to .env and fill in real values

# Change this! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32

# Database — SQLite for dev, change to postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./orbit.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS origins — comma separated; add your phone's LAN URL
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000

# Pairing
PAIRING_CODE_EXPIRE_SECONDS=120

# Heartbeat
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=45
